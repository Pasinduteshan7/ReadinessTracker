# ===== API SETTINGS =====
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# ===== LLM SETTINGS =====
# Choose your LLM provider: together, openai, ollama, huggingface
LLM_PROVIDER=together

# For Together.ai - Get key from https://www.together.ai/
LLM_API_KEY=your_together_api_key_here
LLM_MODEL_NAME=meta-llama/Llama-2-7b-hf-fine-tuned

# LLM Parameters
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=60

# ===== GITHUB SETTINGS =====
GITHUB_TIMEOUT=30

# ===== SUPABASE SETTINGS =====
# Get from Supabase dashboard
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_key_here

# ===== ANALYSIS SETTINGS =====
MAX_REPOS_PER_ANALYSIS=3
MIN_REPO_BACKGROUND_SCORE=40.0
CODE_SNIPPET_MAX_LENGTH=10000

# ===== CACHING =====
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600

# ===== RETRY SETTINGS =====
RETRY_ATTEMPTS=3
RETRY_DELAY_SECONDS=2
