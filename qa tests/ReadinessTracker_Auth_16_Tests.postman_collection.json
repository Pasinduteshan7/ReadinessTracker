{
  "info": {
    "name": "Readiness Tracker - 16 Authentication & Security Tests",
    "description": "Comprehensive test suite matching actual Spring Boot endpoints for Student, Admin, Advisor.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "student_token", "value": "" },
    { "key": "admin_id", "value": "" },
    { "key": "advisor_id", "value": "" }
  ],
  "item": [
    {
      "name": "01. Positive - Valid Student Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
              "pm.test('Token received and saved', function () {",
              "    var data = pm.response.json();",
              "    pm.expect(data).to.have.property('token');",
              "    pm.collectionVariables.set('student_token', data.token);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"eg245365@engug.ruh.ac.lk\",\n  \"password\": \"12345678\"\n}"
        },
        "url": "{{baseUrl}}/api/students/login"
      }
    },
    {
      "name": "02. Positive - Valid Admin Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
              "pm.test('Admin logged in successfully', function () {",
              "    var data = pm.response.json();",
              "    pm.expect(data).to.have.property('id');",
              "    pm.collectionVariables.set('admin_id', data.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@readiness.com\",\n  \"password\": \"admin123\"\n}"
        },
        "url": "{{baseUrl}}/api/admins/login"
      }
    },
    {
      "name": "03. Positive - Valid Advisor Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
              "pm.test('Advisor logged in successfully', function () {",
              "    var data = pm.response.json();",
              "    pm.expect(data).to.have.property('id');",
              "    pm.collectionVariables.set('advisor_id', data.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"advisor@readiness.com\",\n  \"password\": \"advisor123\"\n}"
        },
        "url": "{{baseUrl}}/api/advisors/login"
      }
    },
    {
